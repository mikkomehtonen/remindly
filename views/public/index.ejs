<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Remindly - Events</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Nunito', 'Segoe UI', system-ui, sans-serif;
      line-height: 1.6;
      color: #2d2926;
      max-width: 800px;
      margin: 0 auto;
      padding: 24px;
      background: #faf8f4;
    }
    header {
      background: #ffffff;
      padding: 24px;
      border-radius: 14px;
      margin-bottom: 24px;
      box-shadow: 0 1px 3px rgba(45, 41, 38, 0.06), 0 1px 2px rgba(45, 41, 38, 0.04);
    }
    header h1 {
      font-size: 1.75rem;
      font-weight: 700;
      color: #6a9e7e;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }
    nav { margin-top: 12px; display: flex; gap: 20px; }
    nav a {
      color: #7a7470;
      text-decoration: none;
      font-weight: 400;
      font-size: 0.9375rem;
      transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    nav a:hover { color: #548466; }
    nav a.active { color: #6a9e7e; font-weight: 600; }
    main {
      background: #ffffff;
      padding: 24px;
      border-radius: 14px;
      box-shadow: 0 1px 3px rgba(45, 41, 38, 0.06), 0 1px 2px rgba(45, 41, 38, 0.04);
    }
    h2 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #2d2926;
      margin-bottom: 20px;
      line-height: 1.3;
    }
    .event-card {
      background: #ffffff;
      padding: 20px;
      border-radius: 14px;
      margin-bottom: 12px;
      box-shadow: 0 1px 3px rgba(45, 41, 38, 0.06), 0 1px 2px rgba(45, 41, 38, 0.04);
      transition: box-shadow 200ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .event-card:hover {
      box-shadow: 0 4px 12px rgba(45, 41, 38, 0.08), 0 2px 4px rgba(45, 41, 38, 0.04);
    }
    .event-card h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #2d2926;
      margin-bottom: 8px;
      line-height: 1.3;
    }
    .event-card p {
      color: #2d2926;
      margin-bottom: 12px;
      line-height: 1.6;
    }
    .event-card .category {
      display: inline-block;
      background: #f2efe8;
      color: #548466;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.8125rem;
      font-weight: 600;
    }
    .filter-links { margin: 20px 0; display: flex; gap: 10px; flex-wrap: wrap; }
    .filter-links a {
      display: inline-block;
      padding: 6px 14px;
      background: #f2efe8;
      color: #2d2926;
      border-radius: 999px;
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 600;
      transition: background 150ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .filter-links a:hover { background: #e0dbd4; }
    .filter-links a.active { background: #6a9e7e; color: #ffffff; }
    .empty-state {
      text-align: center;
      padding: 48px 24px;
      color: #7a7470;
    }
    .empty-state p {
      font-size: 1rem;
      line-height: 1.6;
    }
  </style>
</head>
<body>
  <header>
    <h1>Remindly</h1>
    <nav>
      <a href="/" class="active">Home</a>
      <a href="/admin">Admin</a>
    </nav>
  </header>
  <main>
    <h2>Events for <%= date %></h2>
    <div class="filter-links">
      <a href="/" class="<%= typeof alias === 'undefined' || !alias ? 'active' : '' %>">Today</a>
      <a href="/?alias=tomorrow" class="<%= typeof alias !== 'undefined' && alias === 'tomorrow' ? 'active' : '' %>">Tomorrow</a>
      <a href="/?alias=next_week" class="<%= typeof alias !== 'undefined' && alias === 'next_week' ? 'active' : '' %>">Next Week</a>
    </div>
    <% if (events.length === 0) { %>
      <div class="empty-state">
        <p>No events for this date. Enjoy your free time!</p>
      </div>
    <% } else { %>
      <% events.forEach(function(event) { %>
        <div class="event-card">
          <h3><%= event.title %></h3>
          <% if (event.description) { %>
            <p><%= event.description %></p>
          <% } %>
          <span class="category"><%= event.category %></span>
        </div>
      <% }) %>
    <% } %>
  </main>
</body>
</html>
