<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('../partials/favicon') %>
  <title><%= event ? 'Edit Event' : 'New Event' %> - Remindly Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Nunito', 'Segoe UI', system-ui, sans-serif;
      line-height: 1.6;
      color: #2d2926;
      max-width: 700px;
      margin: 0 auto;
      padding: 24px;
      background: #faf8f4;
    }
    header {
      background: #ffffff;
      padding: 24px;
      border-radius: 14px;
      margin-bottom: 24px;
      box-shadow: 0 1px 3px rgba(45, 41, 38, 0.06), 0 1px 2px rgba(45, 41, 38, 0.04);
    }
    header h1 {
      font-size: 1.75rem;
      font-weight: 700;
      color: #6a9e7e;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }
    .logo {
      height: 1.25em;
      width: 1.25em;
      vertical-align: middle;
      margin-right: 0.25em;
    }
    .logo-link {
      text-decoration: none;
    }
    header a {
      color: #6a9e7e;
      text-decoration: none;
      transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    header a:hover { color: #548466; }
    main {
      background: #ffffff;
      padding: 24px;
      border-radius: 14px;
      box-shadow: 0 1px 3px rgba(45, 41, 38, 0.06), 0 1px 2px rgba(45, 41, 38, 0.04);
    }
    .form-group { margin-bottom: 20px; }
    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      font-size: 0.8125rem;
      color: #2d2926;
      letter-spacing: 0.01em;
    }
    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid #e0dbd4;
      border-radius: 10px;
      font-size: 1rem;
      font-family: inherit;
      color: #2d2926;
      background: #ffffff;
      transition: border-color 150ms, box-shadow 150ms;
    }
    .form-group input::placeholder, .form-group textarea::placeholder {
      color: #7a7470;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
      outline: none;
      border-color: #6a9e7e;
      box-shadow: 0 0 0 3px rgba(106, 158, 126, 0.15);
    }
    .form-group textarea { min-height: 100px; resize: vertical; line-height: 1.6; }
    .form-row { display: flex; gap: 16px; }
    .form-row .form-group { flex: 1; }
    .btn {
      display: inline-block;
      padding: 10px 20px;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      text-decoration: none;
      font-size: 0.9375rem;
      font-weight: 600;
      font-family: inherit;
      transition: background 150ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 150ms;
    }
    .btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px #faf8f4, 0 0 0 4px #6a9e7e;
    }
    .btn-primary { background: #6a9e7e; color: #ffffff; }
    .btn-primary:hover { background: #548466; }
    .btn-secondary { background: #f2efe8; color: #2d2926; }
    .btn-secondary:hover { background: #e0dbd4; }
    .alert {
      padding: 12px 16px;
      border-radius: 10px;
      margin-bottom: 20px;
      font-size: 0.9375rem;
    }
    .alert-error {
      background: #f9ece7;
      color: #a85f48;
      border: 1px solid #f0d0c6;
    }
    .alert-error ul { margin-left: 20px; margin-top: 4px; }
    .alert-error li { margin-bottom: 2px; }
    .form-actions { margin-top: 24px; display: flex; gap: 12px; }
    .recurring-fields, .onetime-fields { display: none; }
    .recurring-fields.active, .onetime-fields.active { display: block; }
    .packing-fields { display: none; }
    .packing-fields.active { display: block; }
    .packing-label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      font-size: 0.8125rem;
      color: #2d2926;
      letter-spacing: 0.01em;
    }
    .packing-hint {
      font-size: 0.8125rem;
      color: #7a7470;
      margin-bottom: 10px;
    }
    .packing-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .radio-group {
      display: flex;
      gap: 24px;
      margin-bottom: 20px;
      padding: 16px;
      background: #f2efe8;
      border-radius: 10px;
    }
    .radio-group label {
      font-weight: 400;
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      font-size: 1rem;
      color: #2d2926;
    }
    .radio-group input[type="radio"] {
      width: 18px;
      height: 18px;
      accent-color: #6a9e7e;
      cursor: pointer;
    }
  </style>
  <script>
    function toggleEventType() {
      var recurring = document.querySelector('input[name="is_recurring"]:checked');
      var isRecurring = recurring && recurring.value === '1';
      document.querySelector('.recurring-fields').classList.toggle('active', isRecurring);
      document.querySelector('.onetime-fields').classList.toggle('active', !isRecurring);
    }
    function togglePackingFields() {
      var category = document.getElementById('category');
      var isTravel = category && category.value === 'Travel';
      document.querySelector('.packing-fields').classList.toggle('active', isTravel);
    }
    function initPackingAutogrow() {
      var container = document.querySelector('.packing-fields');
      var MAX_ROWS = 50; // mirrors validatePackingItems in src/routes/admin.js (see also PACKING_MAX_ROWS below)
      container.addEventListener('input', function(e) {
        if (!e.target || e.target.name !== 'packing_items[]') return; // hidden id inputs never match
        var rows = container.querySelectorAll('.packing-row');
        var lastRow = rows[rows.length - 1];
        if (!lastRow || rows.length >= MAX_ROWS) return; // cap reached: never render a 51st row
        var lastInput = lastRow.querySelector('input[name="packing_items[]"]');
        if (!lastInput || lastInput.value.trim() === '') return; // a blank trailing row already exists
        var row = document.createElement('div');
        row.className = 'packing-row';
        var input = document.createElement('input');
        input.type = 'text';
        input.name = 'packing_items[]';
        input.maxLength = 200; // mirrors the 200-char label cap in validatePackingItems
        input.placeholder = 'Add a new packing item';
        row.appendChild(input);
        // Rows must stay inside the form's .form-group wrapper: outside <form> a grown row
        // is never submitted, and outside .form-group it loses the .form-group input styling.
        lastRow.parentNode.appendChild(row);
      });
    }
    window.onload = function() { toggleEventType(); togglePackingFields(); initPackingAutogrow(); };
  </script>
</head>
<body>
  <header>
    <h1><%- include('../partials/logo') %><a href="/admin">Dashboard</a> / <%= event ? 'Edit Event' : 'New Event' %></h1>
  </header>
  <main>
    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-error">
        <ul>
          <% errors.forEach(function(err) { %>
            <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form method="POST"
      <% if (event) { %>
        action="/admin/events/<%= event.id %>?_method=PUT"
      <% } else { %>
        action="/admin/events"
      <% } %>
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="title">Title *</label>
        <input type="text" id="title" name="title" required
          value="<%= event ? event.title : '' %>" placeholder="What's the occasion?">
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" placeholder="Add any details you'd like to remember..."><%= event && event.description ? event.description : '' %></textarea>
      </div>

      <div class="form-group">
        <label for="category">Category *</label>
        <select id="category" name="category" required onchange="togglePackingFields()">
          <option value="">Select a category</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat %>" <%= (event && event.category === cat) ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>

      <div class="radio-group">
        <label>
          <input type="radio" name="is_recurring" value="1" onchange="toggleEventType()"
            <%= (event && event.is_recurring === 1) || (!event) ? 'checked' : '' %>>
          Recurring (every year)
        </label>
        <label>
          <input type="radio" name="is_recurring" value="0" onchange="toggleEventType()"
            <%= (event && event.is_recurring === 0) ? 'checked' : '' %>>
          One-time event
        </label>
      </div>

      <div class="recurring-fields active">
        <div class="form-row">
          <div class="form-group">
            <label for="month">Month *</label>
            <input type="number" id="month" name="month" min="1" max="12"
              value="<%= event && event.month ? event.month : '' %>" placeholder="1-12">
          </div>
          <div class="form-group">
            <label for="day">Day *</label>
            <input type="number" id="day" name="day" min="1" max="31"
              value="<%= event && event.day ? event.day : '' %>" placeholder="1-31">
          </div>
        </div>
      </div>

      <div class="onetime-fields">
        <div class="form-group">
          <label for="event_date">Event Date *</label>
          <input type="date" id="event_date" name="event_date"
            value="<%= event && event.event_date ? event.event_date : '' %>">
        </div>
      </div>

      <%
        var packingList = (typeof packingItems === 'undefined' || !packingItems) ? [] : packingItems;
        // PACKING_MAX_ROWS mirrors the 50-item cap in validatePackingItems (src/routes/admin.js)
        // and MAX_ROWS in the script above. Blanks are clamped so an event already near the cap
        // can never render blank rows whose text would push the submission over it.
        var PACKING_MAX_ROWS = 50;
        var blankRows = Math.min(3, Math.max(0, PACKING_MAX_ROWS - packingList.length));
      %>
      <div class="packing-fields<%= (event && event.category === 'Travel') ? ' active' : '' %>">
        <div class="form-group">
          <span class="packing-label">Packing items</span>
          <p class="packing-hint">Add an item by filling a blank row, rename it by editing its text, remove it by clearing its text.</p>
          <% packingList.forEach(function(it) { %>
            <div class="packing-row">
              <% if (it.id !== '' && it.id !== null && it.id !== undefined) { %>
                <input type="hidden" name="packing_item_ids[]" value="<%= it.id %>">
              <% } %>
              <input type="text" name="packing_items[]" maxlength="200"
                value="<%= it.label %>" placeholder="e.g. Passport">
            </div>
          <% }) %>
          <% for (var blank = 0; blank < blankRows; blank++) { %>
            <div class="packing-row">
              <input type="text" name="packing_items[]" maxlength="200" placeholder="Add a new packing item">
            </div>
          <% } %>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          <%= event ? 'Update Event' : 'Create Event' %>
        </button>
        <a href="/admin" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
