<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Remindly</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Nunito', 'Segoe UI', system-ui, sans-serif;
      line-height: 1.6;
      color: #2d2926;
      max-width: 900px;
      margin: 0 auto;
      padding: 24px;
      background: #faf8f4;
    }
    header {
      background: #ffffff;
      padding: 24px;
      border-radius: 14px;
      margin-bottom: 24px;
      box-shadow: 0 1px 3px rgba(45, 41, 38, 0.06), 0 1px 2px rgba(45, 41, 38, 0.04);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    header h1 {
      font-size: 1.75rem;
      font-weight: 700;
      color: #6a9e7e;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }
    nav { display: flex; align-items: center; gap: 16px; }
    nav a {
      color: #7a7470;
      text-decoration: none;
      font-weight: 400;
      font-size: 0.9375rem;
      transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    nav a:hover { color: #548466; }
    main {
      background: #ffffff;
      padding: 24px;
      border-radius: 14px;
      box-shadow: 0 1px 3px rgba(45, 41, 38, 0.06), 0 1px 2px rgba(45, 41, 38, 0.04);
    }
    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .toolbar h2 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #2d2926;
      line-height: 1.3;
    }
    .btn {
      display: inline-block;
      padding: 10px 20px;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      text-decoration: none;
      font-size: 0.9375rem;
      font-weight: 600;
      font-family: inherit;
      transition: background 150ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 150ms;
    }
    .btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px #faf8f4, 0 0 0 4px #6a9e7e;
    }
    .btn-primary { background: #6a9e7e; color: #ffffff; }
    .btn-primary:hover { background: #548466; }
    .btn-danger { background: #c4735a; color: #ffffff; padding: 6px 12px; font-size: 0.8125rem; }
    .btn-danger:hover { background: #a85f48; }
    .btn-danger:focus-visible { box-shadow: 0 0 0 2px #faf8f4, 0 0 0 4px #c4735a; }
    .btn-secondary { background: #f2efe8; color: #2d2926; padding: 6px 12px; font-size: 0.8125rem; }
    .btn-secondary:hover { background: #e0dbd4; }
    table { width: 100%; border-collapse: collapse; }
    th, td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #ebe7e0;
    }
    th {
      background: #f2efe8;
      font-weight: 600;
      font-size: 0.8125rem;
      color: #2d2926;
      letter-spacing: 0.01em;
    }
    td { color: #2d2926; }
    tr:hover td { background: #faf8f4; }
    .actions { display: flex; gap: 8px; }
    .actions form { display: inline; }
    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.8125rem;
      font-weight: 600;
    }
    .badge-recurring { background: #e0efe5; color: #3f654d; }
    .badge-onetime { background: #f9ece7; color: #a85f48; }
    th a { color: #2d2926; text-decoration: none; }
    th a:hover { color: #6a9e7e; text-decoration: underline; }
    .empty-state {
      text-align: center;
      padding: 48px 24px;
      color: #7a7470;
    }
    .empty-state p {
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 20px;
    }
  </style>
</head>
<body>
  <header>
    <h1>Dashboard</h1>
    <nav>
      <a href="/">Public Site</a>
      <form method="POST" action="/admin/logout" style="display:inline;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-secondary">Logout</button>
      </form>
    </nav>
  </header>
  <main>
    <%
      function sortUrl(col) {
        const params = new URLSearchParams();
        if (sort === col && order === 'ASC') {
          params.set('sort', col);
          params.set('order', 'desc');
        } else {
          params.set('sort', col);
          params.set('order', 'asc');
        }
        if (category) params.set('category', category);
        return '?' + params.toString();
      }
    %>
    <div class="toolbar">
      <h2>Events <span style="font-weight: 400; color: #7a7470; font-size: 0.9375rem;">(<%= events.length %><% if (category) { %> / <%= totalCount %><% } %>)</span></h2>
      <div style="display: flex; gap: 12px; align-items: center;">
        <form method="GET" action="/admin" id="filter-form">
          <input type="hidden" name="sort" value="<%= sort %>">
          <input type="hidden" name="order" value="<%= order %>">
          <select name="category" onchange="document.getElementById('filter-form').submit()" style="padding: 8px 12px; border: 1px solid #ebe7e0; border-radius: 8px; background: #ffffff; font-family: inherit; font-size: 0.875rem; color: #2d2926;">
            <option value="">All Categories</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </form>
        <a href="/admin/events/new" class="btn btn-primary">+ New Event</a>
      </div>
    </div>

    <% if (events.length === 0) { %>
      <div class="empty-state">
        <% if (category) { %>
          <p>No events found for category "<%= category %>".</p>
          <a href="/admin" class="btn btn-primary">Clear Filter</a>
        <% } else { %>
          <p>No events yet. Create your first event to get started!</p>
          <a href="/admin/events/new" class="btn btn-primary">Create Event</a>
        <% } %>
      </div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th><a href="<%= sortUrl('title') %>">Title <%= sort === 'title' ? (order === 'ASC' ? '↑' : '↓') : '' %></a></th>
            <th><a href="<%= sortUrl('category') %>">Category <%= sort === 'category' ? (order === 'ASC' ? '↑' : '↓') : '' %></a></th>
            <th><a href="<%= sortUrl('type') %>">Type <%= sort === 'type' ? (order === 'ASC' ? '↑' : '↓') : '' %></a></th>
            <th><a href="<%= sortUrl('date') %>">Date <%= sort === 'date' ? (order === 'ASC' ? '↑' : '↓') : '' %></a></th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% events.forEach(function(event) { %>
            <tr>
              <td><strong><%= event.title %></strong></td>
              <td><%= event.category %></td>
              <td>
                <% if (event.is_recurring) { %>
                  <span class="badge badge-recurring">Recurring</span>
                <% } else { %>
                  <span class="badge badge-onetime">One-time</span>
                <% } %>
              </td>
              <td>
                <% if (event.is_recurring) { %>
                  <%= String(event.month).padStart(2, '0') %>-<%= String(event.day).padStart(2, '0') %>
                <% } else { %>
                  <%= event.event_date %>
                <% } %>
              </td>
              <td class="actions">
                <a href="/admin/events/<%= event.id %>/edit" class="btn btn-secondary">Edit</a>
                <form method="POST" action="/admin/events/<%= event.id %>?_method=DELETE">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this event?')">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>
