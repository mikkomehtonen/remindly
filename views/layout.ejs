<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/favicon') %>
  <title><%= typeof title !== 'undefined' ? title : 'Remindly' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Nunito', 'Segoe UI', system-ui, sans-serif;
      line-height: 1.6;
      color: #2d2926;
      max-width: 800px;
      margin: 0 auto;
      padding: 24px;
      background: #faf8f4;
    }
    header {
      background: #ffffff;
      padding: 24px;
      border-radius: 14px;
      margin-bottom: 24px;
      box-shadow: 0 1px 3px rgba(45, 41, 38, 0.06), 0 1px 2px rgba(45, 41, 38, 0.04);
    }
    header h1 {
      font-size: 1.75rem;
      font-weight: 700;
      color: #6a9e7e;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }
    nav { margin-top: 12px; display: flex; gap: 20px; }
    nav a {
      color: #7a7470;
      text-decoration: none;
      font-weight: 400;
      font-size: 0.9375rem;
      transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    nav a:hover { color: #548466; }
    nav a.active { color: #6a9e7e; font-weight: 600; }
    main {
      background: #ffffff;
      padding: 24px;
      border-radius: 14px;
      box-shadow: 0 1px 3px rgba(45, 41, 38, 0.06), 0 1px 2px rgba(45, 41, 38, 0.04);
    }
    .event-card {
      background: #ffffff;
      padding: 20px;
      border-radius: 14px;
      margin-bottom: 12px;
      box-shadow: 0 1px 3px rgba(45, 41, 38, 0.06), 0 1px 2px rgba(45, 41, 38, 0.04);
      transition: box-shadow 200ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .event-card:hover {
      box-shadow: 0 4px 12px rgba(45, 41, 38, 0.08), 0 2px 4px rgba(45, 41, 38, 0.04);
    }
    .event-card h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #2d2926;
      margin-bottom: 8px;
      line-height: 1.3;
    }
    .event-card p {
      color: #2d2926;
      margin-bottom: 12px;
      line-height: 1.6;
    }
    .event-card .category {
      display: inline-block;
      background: #f2efe8;
      color: #548466;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.8125rem;
      font-weight: 600;
    }
    .btn {
      display: inline-block;
      padding: 10px 20px;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      text-decoration: none;
      font-size: 0.9375rem;
      font-weight: 600;
      font-family: inherit;
      transition: background 150ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 150ms;
    }
    .btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px #faf8f4, 0 0 0 4px #6a9e7e;
    }
    .btn-primary { background: #6a9e7e; color: #ffffff; }
    .btn-primary:hover { background: #548466; }
    .btn-danger { background: #c4735a; color: #ffffff; padding: 8px 16px; font-size: 0.8125rem; }
    .btn-danger:hover { background: #a85f48; }
    .btn-danger:focus-visible { box-shadow: 0 0 0 2px #faf8f4, 0 0 0 4px #c4735a; }
    .btn-secondary { background: #f2efe8; color: #2d2926; }
    .btn-secondary:hover { background: #e0dbd4; }
    .btn-sm { padding: 6px 12px; font-size: 0.8125rem; }
    .form-group { margin-bottom: 20px; }
    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      font-size: 0.8125rem;
      color: #2d2926;
      letter-spacing: 0.01em;
    }
    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid #e0dbd4;
      border-radius: 10px;
      font-size: 1rem;
      font-family: inherit;
      color: #2d2926;
      background: #ffffff;
      transition: border-color 150ms, box-shadow 150ms;
    }
    .form-group input::placeholder, .form-group textarea::placeholder {
      color: #7a7470;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
      outline: none;
      border-color: #6a9e7e;
      box-shadow: 0 0 0 3px rgba(106, 158, 126, 0.15);
    }
    .form-group textarea { min-height: 100px; resize: vertical; line-height: 1.6; }
    .alert {
      padding: 12px 16px;
      border-radius: 10px;
      margin-bottom: 20px;
      font-size: 0.9375rem;
    }
    .alert-error {
      background: #f9ece7;
      color: #a85f48;
      border: 1px solid #f0d0c6;
    }
    .alert-success {
      background: #e0efe5;
      color: #3f654d;
      border: 1px solid #b5d4c1;
    }
    .actions { margin-top: 24px; display: flex; gap: 8px; }
    .actions form { display: inline; }
    table { width: 100%; border-collapse: collapse; }
    th, td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #ebe7e0;
    }
    th {
      background: #f2efe8;
      font-weight: 600;
      font-size: 0.8125rem;
      color: #2d2926;
      letter-spacing: 0.01em;
    }
    td { color: #2d2926; }
    tr:hover td { background: #faf8f4; }
    .empty-state {
      text-align: center;
      padding: 48px 24px;
      color: #7a7470;
    }
    .empty-state p {
      font-size: 1rem;
      line-height: 1.6;
    }
    .filter-links { margin: 20px 0; display: flex; gap: 10px; flex-wrap: wrap; }
    .filter-links a {
      display: inline-block;
      padding: 6px 14px;
      background: #f2efe8;
      color: #2d2926;
      border-radius: 999px;
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 600;
      transition: background 150ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .filter-links a:hover { background: #e0dbd4; }
    .filter-links a.active { background: #6a9e7e; color: #ffffff; }
  </style>
</head>
<body>
  <header>
    <h1>Remindly</h1>
    <nav>
      <a href="/" class="<%= typeof activeNav !== 'undefined' && activeNav === 'home' ? 'active' : '' %>">Home</a>
      <a href="/admin" class="<%= typeof activeNav !== 'undefined' && activeNav === 'admin' ? 'active' : '' %>">Admin</a>
    </nav>
  </header>
  <main>
    <%- body %>
  </main>
</body>
</html>
