<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error - Remindly</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Nunito', 'Segoe UI', system-ui, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      background: #faf8f4;
      padding: 24px;
    }
    .error-box {
      background: #ffffff;
      padding: 32px;
      border-radius: 14px;
      box-shadow: 0 4px 12px rgba(45, 41, 38, 0.08), 0 2px 4px rgba(45, 41, 38, 0.04);
      text-align: center;
      max-width: 500px;
      width: 100%;
    }
    .error-box h1 {
      font-size: 1.75rem;
      font-weight: 700;
      color: #c4735a;
      margin-bottom: 12px;
      letter-spacing: -0.01em;
    }
    .error-box p {
      color: #7a7470;
      margin-bottom: 24px;
      font-size: 1rem;
      line-height: 1.6;
    }
    .error-box a {
      display: inline-block;
      padding: 10px 20px;
      background: #6a9e7e;
      color: #ffffff;
      text-decoration: none;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.9375rem;
      transition: background 150ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .error-box a:hover { background: #548466; }
  </style>
</head>
<body>
  <div class="error-box">
    <h1>Oops!</h1>
    <p><%= message %></p>
    <a href="/">Go Home</a>
  </div>
</body>
</html>
